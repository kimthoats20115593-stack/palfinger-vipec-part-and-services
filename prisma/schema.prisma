generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

model Category {
  id     String @id @default(cuid())
  slug   String @unique
  nameVi String
  nameEn String
  order  Int    @default(0)
  parts  Part[]
}

model Part {
  id             String   @id @default(cuid())
  sku            String   @unique
  nameVi         String
  nameEn         String
  craneModel     String
  descriptionVi  String
  descriptionEn  String
  image          String
  featured       Boolean  @default(false)
  category       Category @relation(fields: [categoryId], references: [id])
  categoryId     String
  inquiries      Inquiry[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model NewsPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  titleVi     String
  titleEn     String
  excerptVi   String
  excerptEn   String
  contentVi   String
  contentEn   String
  coverImage  String
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum InquiryType {
  QUOTE
  CONTACT
}

enum InquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

model Inquiry {
  id        String        @id @default(cuid())
  type      InquiryType
  name      String
  phone     String
  email     String
  company   String?
  message   String
  status    InquiryStatus @default(NEW)
  part      Part?         @relation(fields: [partId], references: [id])
  partId    String?
  createdAt DateTime      @default(now())
}
